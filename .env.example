# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Database (matches docker-compose.yml service) ────────────────────────────
DATABASE_URL="postgresql://yourcar:yourcar_pass@localhost:5434/yourcar_dev"

# ─── Test Database (separate DB, spun up by docker-compose.test.yml) ──────────
TEST_DATABASE_URL="postgresql://yourcar:yourcar_pass@localhost:5433/yourcar_test"
